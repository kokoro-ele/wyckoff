# ---------- TickFlow market data ----------
# Free endpoint: no API key required; daily and higher timeframes only.
TICKFLOW_BASE_URL=https://free-api.tickflow.org
TICKFLOW_API_KEY=

# ---------- OpenAI-compatible LLM (operator fallback) ----------
# Never put real keys in this example file. Users can override these with their
# own encrypted per-workspace settings in Settings → My model.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Set to 0 when the selected gateway does not support Responses web_search.
OPENAI_WEB_SEARCH=1
# Set to 1 only temporarily when diagnosing prompts. Prompts may contain private research.
DEBUG_LLM=0
# Allow development clients to request tool-trace events. Keep 0 in production.
ALLOW_AGENT_TRACE=0

# ---------- Email registration / verification / password reset ----------
# SMTP_HOST and SMTP_FROM enable email authentication. SMTP_USER/SMTP_PASS are
# optional for local catchers or unauthenticated relays.
# Port 587 requires STARTTLS by default; port 465 uses implicit TLS.
# Local catchers such as Mailpit usually use 1025 with no TLS.
SMTP_HOST=
SMTP_PORT=587
# Optional: force (1) or disable (0) STARTTLS for non-standard ports.
SMTP_REQUIRE_TLS=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SEC EDGAR requires an identifying User-Agent with a contact address.
# Leave empty to use Tencent valuation metrics only.
SEC_USER_AGENT=

# ---------- Service ----------
PORT=8787
# Runtime SQLite cache lives here. This directory is ignored.
DATA_DIR=./data

# ---------- Cloud deployment / authentication ----------
# PostgreSQL is required in cloud mode. Local development also authenticates.
DATABASE_URL=
# Optional PEM CA for providers such as Supabase. Leave empty to use the URL's SSL settings.
DATABASE_SSL_CA=
# Per-instance pg pool size.
PG_POOL_MAX=10
BETTER_AUTH_SECRET=
# Required canonical origin; local development: http://localhost:5273
BETTER_AUTH_URL=
# Google OAuth web application; redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes in hexadecimal; keep stable to decrypt existing workspaces.
WORKSPACE_ENCRYPTION_KEY=

# ---------- Permanent analysis credit packs / Stripe payments ----------
# Leave empty to disable purchases. Amounts are minor units (cents).
# Example: [{"id":"credits_10","name":"10 credits","credits":10,"amount":500,"currency":"USD"}]
ANALYSIS_CREDIT_PACKS=
# HTTPS origin used for checkout return URLs. Local development can use
# http://localhost:5273 with the Stripe CLI.
BILLING_PUBLIC_ORIGIN=

# Stripe server-only credentials (hosted Checkout; no publishable key needed).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
