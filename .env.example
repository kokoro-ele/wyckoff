# ---------- TickFlow market data ----------
# Free endpoint: no API key required; daily and higher timeframes only.
TICKFLOW_BASE_URL=https://free-api.tickflow.org
TICKFLOW_API_KEY=

# ---------- OpenAI-compatible LLM ----------
# Keep the real key only in .env or in the local Settings page. Both storage
# locations are Git-ignored; never put a real key in this example file.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Set to 0 when the selected gateway does not support Responses web_search.
OPENAI_WEB_SEARCH=1

# ---------- Daily US stock recommendations ----------
RECOMMEND_ENABLED=1
RECOMMEND_HOUR=16
RECOMMEND_MINUTE=30
RECOMMEND_TZ=America/New_York
RECOMMEND_BOOK_CAP=25
RECOMMEND_CANDIDATES=10
RECOMMEND_CONCURRENCY=3

# ---------- Optional email delivery ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAIL_TO=

# ---------- Service ----------
PORT=8787
# SQLite and local Settings-page secrets live here. This directory is ignored.
DATA_DIR=./data
